# ADTY AI 部署用的环境变量（任务 10.1）。复制成 .env 再填写：cp .env.example .env && chmod 600 .env
# .env 里是生产密钥，不要提交（仓库根目录的 .gitignore 已经忽略 .env）。
# 密码和密钥用 openssl rand -hex 32 生成：只含 0-9a-f，放进 SQL_DSN、REDIS_CONN_STRING 这类网址里不用转义。

# 镜像：GitHub Actions 在 main 上构建出的 sha 标签（docs/adty/deploy.md「选镜像标签」）。不要用 latest 或 main。
ADTY_IMAGE=ghcr.io/adtyai/adtyai-api:sha-xxxxxxx

# PostgreSQL 和 Redis 的密码。PostgreSQL 的密码只在第一次建库时生效，以后要改得进数据库里改。
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 登录会话密钥和加密密钥，两个分开设、设了就不再改。
SESSION_SECRET=
CRYPTO_SECRET=

# 备份前刷盘的内部接口密钥，同样用 openssl rand -hex 32 生成。
ADTY_FLUSH_TOKEN=

# 浏览器访问的站点地址，只写 https 的 origin（不带路径），多个用英文逗号分隔。
SESSION_COOKIE_TRUSTED_URL=https://adtyai.com

NODE_NAME=adtyai-node-1
TZ=Asia/Shanghai
